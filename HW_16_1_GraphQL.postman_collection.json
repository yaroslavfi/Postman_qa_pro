	"item": [
		{
			"name": "all cities",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const resBody = pm.response.json();",
							"const cities = resBody.data.getAllCities;",
							"",
							"// Вибір 4 випадкових ID",
							"function getRandomIds(arr, count) {",
							"  var randomIds = [];",
							"  while (randomIds.length < count) {",
							"    var randomIndex = Math.floor(Math.random() * arr.length); // Вибір випадкового індексу",
							"    if (randomIds.indexOf(arr[randomIndex].id) === -1) { // Перевірка на унікальність",
							"      randomIds.push(arr[randomIndex].id); // Додавання до масиву",
							"    }",
							"  }",
							"  return randomIds;",
							"}",
							"const randomIds = getRandomIds(cities, 4);",
							"pm.collectionVariables.set(\"randomIds\", JSON.stringify(randomIds));",
							"",
							"//Визначення середнього значення всіх площ усіх міст",
							"const totalArea = cities.reduce((sum, city) => sum + city.square, 0);",
							"const averageArea = totalArea / cities.length;",
							"pm.collectionVariables.set(\"totalArea\", totalArea)",
							"pm.collectionVariables.set(\"averageArea\", averageArea);",
							"console.log(\"Середня площа усіх міст: \" + averageArea);",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time is less than 1000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(1000);",
							"});",
							"",
							"pm.test(\"Content-Type is present\", function () {",
							"    pm.response.to.have.header(\"Content-Type\");",
							"});",
							"",
							"pm.test(\"Server is nginx\", function () {",
							"    pm.response.to.be.header(\"Server\", \"nginx\");",
							"});",
							"",
							"pm.test(\"getAllCities is present\", function () {",
							"    pm.expect(resBody.data.getAllCities).to.exist;",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
