	"item": [
		{
			"name": "Book ISBN Numbers",
			"item": [
				{
					"name": "Is Valid ISBN13 Number",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response time is less than 200ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(200);",
									"});",
									"",
									"pm.test(\"Content-Type is present and the value is correct\", function () {",
									"    pm.response.to.have.header(\"Content-Type\", \"text/xml; charset=utf-8\");",
									"});",
									"",
									"pm.test(\"Content-Encoding is 'gzip'\", function () {",
									"    pm.response.to.have.header(\"Content-Encoding\", \"gzip\");",
									"});",
									"",
									"pm.test(\"Response is XML\", function () {",
									"    const responseText = pm.response.text();",
									"    pm.expect(responseText).to.match(/^<\\?xml.*\\?>/);",
									"});",
									"",
									"const xml2js = require('xml2js');   ",
									"xml2js.parseString(pm.response.text(), function (err, result) {",
									"",
									"    pm.test(\"Response does not contain SOAP Fault\", function () {",
									"    pm.expect(result[\"soap:Envelope\"][\"soap:Body\"]).to.not.have.property(\"soap:Fault\");",
									"    });",
									"",
									"    pm.test(\"soap envelope is correct\", function () {",
									"        pm.expect(result).to.have.property(\"soap:Envelope\");",
									"        pm.expect(result[\"soap:Envelope\"]).to.have.property(\"$\");",
									"        pm.expect(result[\"soap:Envelope\"][\"$\"][\"xmlns:soap\"]).to.eql(\"http://schemas.xmlsoap.org/soap/envelope/\");",
									"    });",
									"",
									"    pm.test(\"body is present\", function () {",
									"        pm.expect(result).to.have.property(\"soap:Envelope\");",
									"        pm.expect(result[\"soap:Envelope\"]).to.have.property(\"soap:Body\");",
									"        pm.expect(result[\"soap:Envelope\"][\"soap:Body\"]).to.not.be.empty;",
									"    });",
									"",
									"    pm.test(\"IsValidISBN13Response is present\", function() {",
									"        pm.expect(result[\"soap:Envelope\"][\"soap:Body\"][0][\"m:IsValidISBN13Response\"]).to.exist;",
									"    });",
									"",
									"    pm.test(\"ISBN13 is valid\", function() {",
									"        pm.expect(result[\"soap:Envelope\"][\"soap:Body\"][0][\"m:IsValidISBN13Response\"][0][\"m:IsValidISBN13Result\"][0]).to.eql(\"true\")",
									"    });",
									"",
									"});",
									"    ",
									"",
									"",
									"",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/xml; charset=utf-8",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
						},
						"url": {
							"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
							"protocol": "http",
							"host": [
								"webservices",
								"daehosting",
								"com"
							],
							"path": [
								"services",
								"isbnservice.wso"
							]
						},
						"description": "The test is done by calculation on the first 12 digits and compare the result with the checksum number at the end. You have to pass a 13 digits number."
					},
					"response": []
				},
